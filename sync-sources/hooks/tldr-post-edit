#!/bin/bash
# ~/.overdeck/bin/tldr-post-edit
# PostToolUse hook on Edit/Write — notifies TLDR to re-warm after code changes.
#
# Tracks dirty files in a lightweight file. When the dirty count exceeds a
# threshold, triggers a background re-warm so the index stays fresh.

# Don't use set -e — never break Claude Code execution
INPUT=$(cat 2>/dev/null || echo '{}')

# Only act on Edit and Write tools
TOOL_NAME=$(echo "$INPUT" | jq -r '.tool_name // ""' 2>/dev/null)
if [ "$TOOL_NAME" != "Edit" ] && [ "$TOOL_NAME" != "Write" ]; then
  exit 0
fi

# Extract file path
FILE_PATH=$(echo "$INPUT" | jq -r '.tool_input.file_path // ""' 2>/dev/null)
if [ -z "$FILE_PATH" ]; then
  exit 0
fi

# Only track code files
EXT="${FILE_PATH##*.}"
EXT_LOWER=$(echo "$EXT" | tr '[:upper:]' '[:lower:]')
case "$EXT_LOWER" in
  ts|tsx|js|jsx|py|java|go|rs|cpp|c|h|hpp|rb|php|kt|swift|cs|scala|lua|ex|exs)
    ;;
  *)
    exit 0
    ;;
esac

# Find project root (where .venv lives). Stop at the file's own repo boundary
# (.git entry — worktrees have a .git *file*): a checkout without its own venv
# must NOT attribute dirty files to an enclosing checkout, whose index cannot
# resolve this file's relative paths (PAN-3534).
PROJECT_DIR=""
DIR="$(dirname "$FILE_PATH")"
while [ "$DIR" != "/" ]; do
  if [ -d "$DIR/.venv" ]; then
    PROJECT_DIR="$DIR"
    break
  fi
  if [ -e "$DIR/.git" ]; then
    break
  fi
  DIR=$(dirname "$DIR")
done

if [ -z "$PROJECT_DIR" ]; then
  exit 0
fi

# Track dirty files
DIRTY_FILE="$PROJECT_DIR/.tldr/dirty-files"
mkdir -p "$PROJECT_DIR/.tldr" 2>/dev/null || true

# Append the changed file (deduplicated on warm)
REL_PATH="${FILE_PATH#$PROJECT_DIR/}"
echo "$REL_PATH" >> "$DIRTY_FILE" 2>/dev/null || true

# Count dirty files (fast line count)
DIRTY_COUNT=$(wc -l < "$DIRTY_FILE" 2>/dev/null || echo 0)

# Trigger background re-warm after 10 edits (keeps index reasonably fresh).
# flock dedup (PAN-3534): warms were observed stacking 4-deep because neither
# this hook nor `tldr warm` holds any lock. The lock must cover the warm's
# full duration, so no --background (that detaches a child the lock can't
# cover) — instead the whole flocked subshell is backgrounded. If a warm is
# already running, the dirty list is kept so a later edit re-attempts.
WARM_THRESHOLD=10
if [ "$DIRTY_COUNT" -ge "$WARM_THRESHOLD" ]; then
  TLDR_BIN="$PROJECT_DIR/.venv/bin/tldr"
  if [ -x "$TLDR_BIN" ]; then
    WARM_LOCK="$PROJECT_DIR/.tldr/warm.lock"
    (
      flock -n 200 || exit 0
      : > "$DIRTY_FILE" 2>/dev/null || true
      cd "$PROJECT_DIR" && "$TLDR_BIN" warm .
    ) 200>"$WARM_LOCK" >/dev/null 2>&1 &
  fi
fi

exit 0
