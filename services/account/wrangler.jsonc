{
  "name": "overdeck-account",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "account.overdeck.ai", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "overdeck-account",
      // Placeholder: the operator replaces it with the id printed when creating the D1 database (docs/ACCOUNT-SERVICE.md "Deploy"). `--local` ignores it.
      "database_id": "25137ba7-bb02-44ae-9658-6f855adc49f4",
      "migrations_dir": "migrations"
    }
  ],
  // Cross-script binding to the connect Worker's per-account Durable Object (PAN-4959 D-2). The class is defined in
  // overdeck-connect, so there is no "migrations" entry here, and overdeck-connect must be deployed first.
  "durable_objects": {
    "bindings": [{ "name": "DIRECTORY", "class_name": "AccountDirectory", "script_name": "overdeck-connect" }]
  },
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "PUBLIC_BASE_URL": "https://account.overdeck.ai",
    "SHARE_BASE_URL": "https://share.overdeck.ai",
    // Creem live API (PAN-4294 D-3). Test deployments use https://test-api.creem.io.
    "CREEM_API_BASE": "https://api.creem.io"
  }
  // GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, OWNER_GITHUB_ID: Worker secrets set by the operator (docs/ACCOUNT-SERVICE.md "Deploy").
  // Billing (PAN-4294): CREEM_API_KEY and CREEM_WEBHOOK_SECRET are Worker secrets; the operator adds the CREEM_PRODUCTS var
  // (JSON, each of the six product keys -> its Creem product id) and optionally FOUNDING_ENDS_AT (ISO 8601) once the
  // products exist in Creem. Until all are set, billing stays off.
  // "services": [{ "binding": "VAULT", "service": "overdeck-vault", "entrypoint": "VaultRpc" }] — added by PAN-4297.
}
