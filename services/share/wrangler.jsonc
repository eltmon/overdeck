{
  "name": "overdeck-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "share.overdeck.ai", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ShareRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShareRoom"] }],
  "services": [{ "binding": "ACCOUNT", "service": "overdeck-account", "entrypoint": "AccountRpc" }],
  "ratelimits": [{ "name": "ROOM_CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // The hosted viewer bundle (PAN-4481 D-9): the Worker runs first, so /viewer/viewer.js keeps its security headers.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "build": { "command": "node scripts/build-web.mjs" },
  "vars": { "PUBLIC_BASE_URL": "https://share.overdeck.ai", "ACCOUNT_BASE_URL": "https://account.overdeck.ai" }
  // TURN_KEY_ID, TURN_KEY_API_TOKEN, WEB_SESSION_KEY: Worker secrets set by the operator (docs/SHARED-SESSIONS.md "Deploy").
}
