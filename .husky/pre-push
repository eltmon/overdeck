#!/bin/sh
# Pre-push guard: refuse to push a vX.Y.Z tag unless it was produced by
# `pan release stable` — i.e. all three package.json versions match the tag
# AND .release/<tag>.md is committed at the tagged commit.
#
# Bypass with `git push --no-verify` if you really know what you're doing.

set -e

# PAN-2227: ratchets enforce at the write point — catch god-file growth
# before origin does. Checks the WORKING TREE (what a direct-to-main
# writer is about to make main), not each pushed commit.
bash scripts/lint-file-size.sh </dev/null

read_version() {
  git show "$1:$2" 2>/dev/null | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>console.log(JSON.parse(d).version))"
}

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  zero=0000000000000000000000000000000000000000
  if [ "$local_sha" = "$zero" ]; then
    # Refuse deleting the state branch — it holds the canonical pipeline
    # state plane (PAN-2541) and shares no history with any code branch.
    if [ "$remote_ref" = "refs/heads/overdeck-state" ]; then
      echo "✖ refusing to delete overdeck-state — it is the canonical pipeline state plane (PAN-2541)." >&2
      exit 1
    fi
    continue  # ref deletion — nothing to audit
  fi

  case "$remote_ref" in
    refs/heads/*)
      # PAN-2227: audited ratchet bumps — every pushed commit that raises a
      # baseline entry or adds an eslint-any-allowlist entry must reference
      # an issue in its message.
      if [ "$remote_ref" = "refs/heads/main" ] && [ "$remote_sha" != "$zero" ]; then
        base="$remote_sha"
      else
        base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
      fi
      if [ -n "$base" ]; then
        branch_name="${remote_ref#refs/heads/}"
        bash scripts/guard-state-plane-branches.sh --branch "$branch_name" --range "$base..$local_sha" </dev/null
        if [ "$remote_ref" = "refs/heads/main" ]; then
          bash scripts/guard-agent-main-push.sh --range "$base..$local_sha" </dev/null
        fi
        bash scripts/lint-ratchet-audit.sh --range "$base..$local_sha" </dev/null
      else
        if [ "$remote_ref" = "refs/heads/main" ]; then
          bash scripts/guard-agent-main-push.sh --range "" </dev/null
          echo "⚠ ratchet audit: no base for $remote_ref — skipping" >&2
        else
          echo "⚠ ratchet audit: no base for $remote_ref — skipping" >&2
        fi
      fi
      ;;
    refs/tags/v*)
      tag="${remote_ref#refs/tags/}"
      expected="${tag#v}"

      # Skip non-release tags (e.g. v1-archive). Only enforce on semver-shaped tags.
      if ! echo "$expected" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-canary\.[0-9]+)?$'; then
        continue
      fi

      tag_commit="$local_sha"
      root_v=$(read_version "$tag_commit" "package.json")
      desktop_v=$(read_version "$tag_commit" "apps/desktop/package.json")
      contracts_v=$(read_version "$tag_commit" "packages/contracts/package.json")
      notes_path=".release/${tag}.md"

      fail=0
      if [ "$root_v" != "$expected" ]; then
        echo "  package.json version at $tag is $root_v, expected $expected" >&2
        fail=1
      fi
      if [ "$desktop_v" != "$expected" ]; then
        echo "  apps/desktop/package.json version at $tag is $desktop_v, expected $expected" >&2
        fail=1
      fi
      if [ "$contracts_v" != "$expected" ]; then
        echo "  packages/contracts/package.json version at $tag is $contracts_v, expected $expected" >&2
        fail=1
      fi
      if ! git cat-file -e "${tag_commit}:${notes_path}" 2>/dev/null; then
        echo "  $notes_path is not committed at $tag" >&2
        fail=1
      fi

      if [ "$fail" -ne 0 ]; then
        echo "" >&2
        echo "Refusing to push $tag — it was not produced by 'pan release stable'." >&2
        echo "Run: pan release stable --version $expected" >&2
        echo "(or use 'git push --no-verify' to override, but CI will reject it too)" >&2
        exit 1
      fi
      echo "Release guard passed for $tag"
      ;;
  esac
done

exit 0
