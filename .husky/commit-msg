#!/bin/sh
# The overdeck-state worktree shares this repo's core.hooksPath but carries
# no package.json/node_modules, so `npx --no commitlint` fails there and
# blocks the state write door's commits (PAN-2677). Code-repo conventions
# only apply to code checkouts; skip when the tooling is absent.
[ -f package.json ] || exit 0

# 1. Conventional-commits lint (project convention).
npx --no -- commitlint --edit "$1" || exit 1

# 2. Guard: block commits that change a `package.json` "version" field unless
# the commit subject is produced by `pan release stable` or the batch version
# ship step. Catches the failure mode where someone manually bumps a version
# (which silently breaks the npm publish — see v0.9.0).

staged_pkg_changes=$(git diff --cached --name-only | grep -E '(^|/)package\.json$' || true)
if [ -z "$staged_pkg_changes" ]; then
  exit 0
fi

# Merge commits legitimately bring in version bumps from main (e.g. a release
# commit merged via `pan sync-main`). Skip the version guard for merge commits.
merge_head_file="$(git rev-parse --git-dir)/MERGE_HEAD"
if [ -f "$merge_head_file" ]; then
  exit 0
fi

version_changed=0
for pkg in $staged_pkg_changes; do
  if git diff --cached --name-status -- "$pkg" | grep -Eq '^A[[:space:]]'; then
    continue
  fi
  if git diff --cached -U0 "$pkg" | grep -E '^[-+]\s*"version"\s*:' >/dev/null; then
    version_changed=1
    break
  fi
done

if [ "$version_changed" -eq 0 ]; then
  exit 0
fi

first_line=$(head -n 1 "$1")
if echo "$first_line" | grep -Eq '^chore: release [0-9]+\.[0-9]+\.[0-9]+(-canary\.[0-9]+)?$|^chore: bump version to [0-9]+\.[0-9]+\.[0-9]+$'; then
  exit 0
fi

cat >&2 <<EOF

Refusing to commit a package.json version change outside of \`pan release stable\`
or the batch version ship step.

Detected version field changes staged in:
$(echo "$staged_pkg_changes" | sed 's/^/  /')

Commit subject: $first_line

If this is a release, abort and run:

  pan release stable --version X.Y.Z

If you're editing dependencies or scripts and the version diff is unintended,
unstage the version line:

  git restore --staged package.json   # then edit out the version change

The batch version ship step uses this subject:

  chore: bump version to X.Y.Z

EOF
exit 1
