{
  "name": "@overdeck/core",
  "version": "0.61.0",
  "description": "Multi-agent orchestration for AI coding assistants (Claude Code, Codex, Cursor, Gemini CLI)",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "orchestration",
    "claude-code",
    "codex",
    "cursor",
    "gemini",
    "multi-agent",
    "devtools",
    "linear"
  ],
  "author": "Edward Becker <edward.becker@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eltmon/overdeck.git"
  },
  "homepage": "https://github.com/eltmon/overdeck#readme",
  "funding": "https://github.com/sponsors/overdeck-ai",
  "bugs": {
    "url": "https://github.com/eltmon/overdeck/issues"
  },
  "type": "module",
  "trustedDependencies": [
    "@lydell/node-pty"
  ],
  "workspaces": {
    "packages": [
      "packages/contracts",
      "packages/effect-acp",
      "packages/moonshine-linux-x64",
      "packages/qwen-tts-linux-x64",
      "packages/pi-extension",
      "packages/ohmypi-extension",
      "src/dashboard/server",
      "src/dashboard/frontend",
      "apps/desktop"
    ],
    "catalog": {
      "effect": "4.0.0-beta.73",
      "@effect/platform-bun": "4.0.0-beta.73",
      "@effect/platform-node": "4.0.0-beta.73",
      "@effect/sql-sqlite-bun": "4.0.0-beta.73",
      "@effect/vitest": "4.0.0-beta.73",
      "@effect/language-service": "0.84.2",
      "@types/bun": "^1.2.0",
      "typescript": "^5.7.3"
    }
  },
  "bin": {
    "overdeck": "./dist/cli/index.js",
    "pan": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle",
    "sync-sources",
    "scripts",
    "roles",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.73",
    "@pierre/diffs": "1.1.22",
    "dompurify": "^3.4.13",
    "lodash-es": "^4.18.0",
    "nanoid": "^3.3.18",
    "tar": "^7.5.21",
    "unrun": "0.2.39"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "eval": "cd evals && evalite .",
    "generate:slash-commands": "node scripts/generate-slash-commands.mjs",
    "build": "npm run build:contracts && npm run build:pi-extension && npm run build:ohmypi-extension && npm run build:cli && node scripts/build-post-cli.mjs",
    "build:pi-extension": "npm --prefix ./packages/pi-extension run build",
    "build:ohmypi-extension": "npm --prefix ./packages/ohmypi-extension run build",
    "build:cli": "node scripts/build-cli.mjs",
    "build:docs-index": "node scripts/build-docs-index.mjs",
    "build:contracts": "node scripts/fs-helper.mjs rmrf packages/contracts/dist && npm --prefix ./packages/contracts run build",
    "build:contracts:incremental": "npm --prefix ./packages/contracts run build",
    "build:scripts": "cd sync-sources/hooks && tsdown",
    "build:dashboard": "npm run build:dashboard:frontend && npm run build:dashboard:server",
    "build:dashboard:frontend": "npm --prefix ./src/dashboard/frontend run build",
    "build:dashboard:server": "npm run build:contracts && npm run build:dashboard:server:bundle",
    "build:dashboard:server:hot": "npm run build:contracts:incremental && npm run build:dashboard:server:bundle",
    "build:dashboard:server:bundle": "npm --prefix ./src/dashboard/server run build && node scripts/fs-helper.mjs copy-ext .md src/lib/cloister/prompts dist/dashboard/prompts",
    "build:sidecar": "node scripts/build-moonshine-sidecars.js",
    "build:desktop": "cd apps/desktop && bun run build && bun run dist:linux && bun run dist:mac && bun run dist:win",
    "build:desktop:linux": "cd apps/desktop && bun run build && bun run dist:linux",
    "build:desktop:mac": "cd apps/desktop && bun run build && bun run dist:mac",
    "build:desktop:win": "cd apps/desktop && bun run build && bun run dist:win",
    "pretypecheck": "npm run build:contracts",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks && npm run typecheck:evals && npm run typecheck:dashboard && npm run typecheck:frontend && npm run typecheck:acp",
    "typecheck:acp": "tsc --noEmit -p packages/effect-acp/tsconfig.json",
    "typecheck:hooks": "tsc --noEmit -p tsconfig.hooks.json",
    "typecheck:evals": "tsc --noEmit -p tsconfig.evals.json",
    "lint": "eslint src/ --ext .js,.ts,.tsx --no-inline-config && npm run lint:effect && npm run lint:permissions && npm run lint:no-state-layer && npm run lint:overdeck-boundaries && npm run lint:pipeline-membership && npm run lint:liveness && npm run lint:harness-storage && npm run lint:workspace-doors && npm run lint:park-exits && npm run lint:agent-dir-removal && npm run lint:skills && npm run lint:slash-commands && npm run lint:prompts && npm run lint:prompt-trailer && npm run lint:file-size && npm run lint:source-introspection && npm run lint:no-coderabbit-merge-gate && npm run lint:circular && npm run lint:ratchet-audit && npm run lint:quarantine-audit && npm run lint:effect-facades && npm run lint:effect-diagnostics",
    "lint:effect-diagnostics": "bash scripts/lint-effect-diagnostics.sh",
    "lint:effect-facades": "bash scripts/lint-effect-facades.sh",
    "lint:pipeline-membership": "bash scripts/lint-pipeline-membership.sh",
    "lint:workspace-doors": "bash scripts/guard-workspace-doors.sh",
    "lint:park-exits": "bash scripts/guard-park-exits.sh",
    "lint:agent-dir-removal": "bash scripts/guard-agent-dir-removal.sh",
    "lint:circular": "bash scripts/lint-circular-deps.sh",
    "lint:quarantine-audit": "bash scripts/lint-quarantine-audit.sh",
    "lint:effect": "node scripts/check-effect-versions.mjs",
    "lint:permissions": "bash scripts/lint-permissions.sh",
    "lint:no-state-layer": "bash scripts/guard-no-state-layer.sh",
    "lint:overdeck-boundaries": "PAN_OVERDECK_BOUNDARY_LINT=1 bash scripts/lint-overdeck-boundaries.sh",
    "prelint:skills": "npm run build:contracts && npm run build:pi-extension && npm run build:ohmypi-extension && npm run build:cli",
    "lint:skills": "bash scripts/lint-skills.sh",
    "lint:slash-commands": "bash scripts/lint-slash-commands.sh",
    "lint:prompts": "bash scripts/lint-prompts.sh",
    "lint:prompt-trailer": "bash scripts/check-prompt-change-trailer.sh",
    "lint:file-size": "bash scripts/lint-file-size.sh",
    "lint:source-introspection": "bash scripts/lint-source-introspection.sh",
    "lint:no-coderabbit-merge-gate": "bash scripts/lint-no-coderabbit-merge-gate.sh",
    "lint:dist-externals": "node scripts/lint-dist-externals.mjs",
    "lint:ratchet-audit": "bash scripts/lint-ratchet-audit.sh",
    "pretest": "npm run build:contracts && npm run build:pi-extension && npm run build:ohmypi-extension && npm run build:cli",
    "test": "vitest run --configLoader runner && npm run test:frontend-subset",
    "test:frontend-subset": "npm --prefix ./src/dashboard/frontend run test -- src/lib/__tests__/issueActions.test.ts src/lib/__tests__/issueActions.no-actions-lost.test.ts src/lib/__tests__/issueActions.parity.test.tsx src/__tests__/fr7-conversation-pending-input.test.tsx src/components/Settings/sections/__tests__/TieredExecutionSection.test.tsx src/components/Settings/sections/__tests__/tiered-crews.test.ts",
    "test:unit": "vitest run --configLoader runner tests/unit",
    "test:integration": "vitest run --configLoader runner tests/integration",
    "test:e2e": "vitest run --configLoader runner tests/e2e",
    "test:drizzle-smoke": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck scripts/drizzle-node-sqlite-smoke.ts && node --import tsx scripts/drizzle-node-sqlite-smoke.ts",
    "test:overdeck-db": "vitest run --configLoader runner tests/unit/scripts/create-overdeck-db.test.ts",
    "db:overdeck:init": "node --import tsx scripts/create-overdeck-db-cli.ts",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.mjs || true",
    "prepare": "husky && effect-language-service patch",
    "typecheck:dashboard": "bash scripts/lint-dashboard-types.sh",
    "typecheck:frontend": "bash scripts/lint-frontend-types.sh",
    "lint:harness-storage": "bash scripts/lint-harness-storage.sh",
    "lint:liveness": "bash scripts/lint-liveness.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.118",
    "@anthropic-ai/sdk": "^0.96.0",
    "@effect/platform-bun": "4.0.0-beta.73",
    "@effect/platform-node": "4.0.0-beta.73",
    "@effect/platform-node-shared": "4.0.0-beta.73",
    "@effect/vitest": "4.0.0-beta.73",
    "@google-cloud/speech": "^7.5.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@huggingface/transformers": "^4.3.0",
    "@iarna/toml": "^2.2.5",
    "@linear/sdk": "^70.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@octokit/rest": "^22.0.1",
    "@parcel/watcher": "^2.6.0",
    "@types/mustache": "^4.2.6",
    "@types/ws": "^8.18.1",
    "ai": "^6.0.291",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "conf": "^12.0.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "effect": "4.0.0-beta.73",
    "execa": "^8.0.1",
    "inquirer": "^9.3.8",
    "js-yaml": "^4.3.2",
    "mustache": "^4.2.0",
    "ora": "^8.2.0",
    "posthog-node": "^5.53.0",
    "smee-client": "^5.0.0",
    "sqlite-vec": "^0.1.9",
    "toml": "^4.3.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@napi-rs/canvas": "^1.0.9",
    "@overdeck/contracts": "workspace:*",
    "@posthog/cli": "0.8.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/inquirer": "^9.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoevals": "^0.3.0",
    "cross-env": "^10.1.0",
    "effect-acp": "workspace:*",
    "eslint": "^8.57.1",
    "evalite": "^0.19.0",
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "playwright": "^1.63.0",
    "ts-morph": "^28.0.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.23.15",
    "typedoc": "^0.25.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
